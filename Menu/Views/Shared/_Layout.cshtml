<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexora Menu</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Menu.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --brand: #FF6B35;
                --brand-dark: #E85A2A;
                --brand-light: #FFF1EB;
                --text-dark: #1F2937;
                --text-muted: #6B7280;
                --surface: #FFFFFF;
                --bg: #FAFAFA;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background-color: var(--bg);
                color: var(--text-dark);
            }

            /* ---------- Navbar ---------- */
            .navbar-modern {
                background: var(--surface);
                box-shadow: 0 2px 12px rgba(0,0,0,0.06);
                padding: 0.75rem 0;
            }

            .brand-logo {
                font-weight: 700;
                font-size: 1.5rem;
                color: var(--brand) !important;
                letter-spacing: -0.5px;
            }

            .nav-link-modern {
                font-weight: 500;
                color: var(--text-dark) !important;
                margin: 0 0.5rem;
                transition: color 0.2s ease;
            }

                .nav-link-modern:hover {
                    color: var(--brand) !important;
                }

            /* ---------- Search bar ---------- */
            .search-form {
                flex: 1;
                max-width: 480px;
            }

            .search-input-group {
                position: relative;
            }

            .search-input {
                border-radius: 50px;
                padding: 0.55rem 1rem 0.55rem 2.75rem;
                border: 1px solid #E5E7EB;
                background: var(--bg);
                font-size: 0.9rem;
                width: 100%;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .search-input:focus {
                    outline: none;
                    border-color: var(--brand);
                    box-shadow: 0 0 0 3px rgba(255,107,53,0.12);
                    background: var(--surface);
                }

            .search-icon {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                pointer-events: none;
            }

            /* ---------- Filter dropdown ---------- */
            .filter-btn {
                border-radius: 50px;
                padding: 0.55rem 1.1rem;
                border: 1px solid #E5E7EB;
                background: var(--surface);
                font-weight: 500;
                font-size: 0.9rem;
                color: var(--text-dark);
                display: flex;
                align-items: center;
                gap: 0.4rem;
                white-space: nowrap;
            }

                .filter-btn:hover {
                    border-color: var(--brand);
                    color: var(--brand);
                }

            .dropdown-menu-modern {
                border-radius: 14px;
                border: none;
                box-shadow: 0 8px 28px rgba(0,0,0,0.12);
                padding: 0.75rem;
                min-width: 220px;
            }

                .dropdown-menu-modern .form-check {
                    padding: 0.4rem 0.5rem;
                    border-radius: 8px;
                }

                    .dropdown-menu-modern .form-check:hover {
                        background: var(--brand-light);
                    }

            /* ---------- Footer ---------- */
            footer.footer-modern {
                background: var(--surface);
                border-top: 1px solid #EEE;
                padding: 1.5rem 0;
                font-size: 0.85rem;
                color: var(--text-muted);
            }

            @@media (max-width: 767px) {
                .search-form {
                    max-width: 100%;
                    margin-top: 0.75rem;
                }
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-modern sticky-top">
            <div class="container-fluid px-3 px-md-4">

                <a class="navbar-brand brand-logo" asp-area="" asp-controller="Menu" asp-action="Index">
                    🍽️ Nexora Menu
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-md-flex align-items-center justify-content-between flex-grow-1 ms-md-4">

                    <!-- Search bar -->
                    <form class="search-form d-flex my-2 my-md-0" asp-controller="Menu" asp-action="Index" method="get">
                        <div class="search-input-group w-100">
                            <span class="search-icon">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                </svg>
                            </span>
                            <input type="text" name="search" class="search-input" placeholder="Search dishes..." value="@Context.Request.Query["search"]" />
                        </div>
                    </form>

                    <!-- Filter + nav links -->
                    <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">

                        <div class="dropdown">
                            <button class="filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M6 10.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5m-2-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5m-2-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5" />
                                </svg>
                                Filter
                            </button>
                            <form class="dropdown-menu dropdown-menu-modern p-3" asp-controller="Menu" asp-action="Index" method="get">
                                <p class="fw-semibold mb-2 small text-uppercase text-muted">Sort by price</p>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="sort" value="price_asc" id="sortAsc">
                                    <label class="form-check-label" for="sortAsc">Low to High</label>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" name="sort" value="price_desc" id="sortDesc">
                                    <label class="form-check-label" for="sortDesc">High to Low</label>
                                </div>
                                <button type="submit" class="btn btn-sm w-100" style="background:var(--brand); color:white; border-radius:8px;">
                                    Apply
                                </button>
                            </form>
                        </div>

                        <a class="nav-link-modern" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-modern">
        <div class="container text-center">
            &copy; 2026 - Nexora Menu - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none" style="color:var(--brand);">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>