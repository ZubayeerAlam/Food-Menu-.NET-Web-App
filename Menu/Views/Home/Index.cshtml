@{
    ViewData["Title"] = "Welcome";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #FFF1EB 0%, #FFE4D6 100%);
        border-radius: 24px;
        padding: 4rem 2rem;
        text-align: center;
        margin-top: 1.5rem;
        margin-bottom: 3rem;
    }

    .hero-title {
        font-size: 2.75rem;
        font-weight: 700;
        color: #1F2937;
        letter-spacing: -1px;
    }

        .hero-title span {
            color: #FF6B35;
        }

    .hero-subtitle {
        font-size: 1.1rem;
        color: #6B7280;
        max-width: 560px;
        margin: 1rem auto 2rem;
    }

    .cta-btn {
        background: #FF6B35;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 0.8rem 2.2rem;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        display: inline-block;
        transition: background 0.2s ease, transform 0.2s ease;
        box-shadow: 0 6px 18px rgba(255,107,53,0.3);
    }

        .cta-btn:hover {
            background: #E85A2A;
            transform: translateY(-2px);
            color: white;
        }

    .feature-card {
        background: white;
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .feature-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(0,0,0,0.08);
        }

    .feature-icon {
        font-size: 2.2rem;
        margin-bottom: 0.75rem;
    }

    .feature-title {
        font-weight: 600;
        font-size: 1.05rem;
        margin-bottom: 0.4rem;
        color: #1F2937;
    }

    .feature-text {
        font-size: 0.9rem;
        color: #6B7280;
        margin-bottom: 0;
    }
</style>

<div class="hero-section">
    <h1 class="hero-title">Discover dishes you'll <span>love</span></h1>
    <p class="hero-subtitle">
        Browse our menu, search for your favorite dishes, and explore ingredients — all in one place.
    </p>
    <a asp-controller="Menu" asp-action="Index" class="cta-btn">Browse the Menu</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon">🔍</div>
            <h5 class="feature-title">Search Easily</h5>
            <p class="feature-text">Find any dish instantly by name using our quick search bar.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon">💰</div>
            <h5 class="feature-title">Sort by Price</h5>
            <p class="feature-text">Filter dishes from low to high price to match your budget.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon">🧾</div>
            <h5 class="feature-title">See Ingredients</h5>
            <p class="feature-text">View full ingredient details for every dish before you order.</p>
        </div>
    </div>
</div>