@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .privacy-section {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
        margin-top: 1.5rem;
        margin-bottom: 2rem;
    }

        .privacy-section h1 {
            font-weight: 700;
            color: #1F2937;
            margin-bottom: 0.5rem;
        }

        .privacy-section .updated {
            font-size: 0.85rem;
            color: #6B7280;
            margin-bottom: 2rem;
        }

        .privacy-section h2 {
            font-size: 1.15rem;
            font-weight: 600;
            color: #FF6B35;
            margin-top: 1.75rem;
            margin-bottom: 0.5rem;
        }

        .privacy-section p,
        .privacy-section li {
            color: #4B5563;
            font-size: 0.95rem;
            line-height: 1.6;
        }
</style>

<div class="privacy-section">
    <h1>@ViewData["Title"]</h1>
    <p class="updated">Last updated: October 2026</p>

    <h2>What We Collect</h2>
    <p>
        Nexora Menu only collects the minimum information needed to run this site —
        such as the dishes and ingredients you browse. We do not require you to create
        an account to view the menu.
    </p>

    <h2>How We Use Information</h2>
    <p>
        Any data stored (such as dish and ingredient details) is used solely to display
        the menu and is not shared with third parties.
    </p>

    <h2>Cookies</h2>
    <p>
        This site may use basic cookies to remember your search or filter preferences
        while you browse. No tracking or advertising cookies are used.
    </p>

    <h2>Contact</h2>
    <p>
        If you have any questions about this privacy policy, please contact the site owner.
    </p>
</div>